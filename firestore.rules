rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return (
        isSignedIn() && (
          request.auth.token.email == 'rk89experiment@gmail.com' ||
          request.auth.token.email == 'tiwarigautam819@gmail.com' ||
          request.auth.token.email == 'tiwarigautam8200@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Tracks collection: 100% reliable public streaming, playback & admin track management
    match /tracks/{trackId} {
      allow read, write: if true;
    }

    // Messages collection: Public submissions, admin read/manage
    match /messages/{messageId} {
      allow create: if true;
      allow read, delete: if true;
      allow update: if false;
    }

    // Admin registry
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
